{
  "name": "graduation-organizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "oxlint src tests *.ts --deny-warnings",
    "styles:build": "tailwindcss -c tailwind.config.cjs -i src/styles/tailwind.css -o src/styles/tailwind.generated.css --minify"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.3.1",
    "dexie": "4.2.1",
    "docx": "9.5.1",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "fake-indexeddb": "6.2.4",
    "jsdom": "27.0.1",
    "tailwindcss": "3.4.19",
    "oxlint": "1.89.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@12.15.0"
}
